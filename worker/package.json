{
  "name": "lampang-pround-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --config wrangler.new-account.toml",
    "db:migrate:local": "wrangler d1 migrations apply lampang-pround --local",
    "db:migrate:staging": "wrangler d1 migrations apply lampang-pround --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply lampang-pround --config wrangler.new-account.toml --remote",
    "typecheck": "tsc --noEmit",
    "test:regression": "node test/regression.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250903.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.129.0"
  }
}
